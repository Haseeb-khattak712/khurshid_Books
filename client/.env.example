# Supabase Configuration (Required for Database, Auth & Storage)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://qkamlwrxzprnqmllrnwz.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public App URL (Used for Stripe checkout return redirects)
VITE_PUBLIC_URL=http://localhost:5173

# Serverless API Keys (Required only if using Stripe payments or Resend emails)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STRIPE_SECRET_KEY=your_stripe_secret_key
RESEND_API_KEY=your_resend_api_key
